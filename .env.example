# REQUIRED: Set these in production
SECRET_KEY=your-secret-key-at-least-32-bytes-long-change-this-in-production
WEBHOOK_SECRET=your-webhook-secret-change-this-in-production

# Environment
ENV=production
DEBUG=false

# Database (optimized for laptops)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/simpai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=RedisCache
CACHE_DEFAULT_TIMEOUT=60
RATELIMIT_STORAGE_URI=redis://localhost:6379/1

# Rate Limiting
RATELIMIT_DEFAULT=300 per minute

# JWT
JWT_EXP_MINUTES=15
JWT_REFRESH_DAYS=30

# Security
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
MAX_CONTENT_LENGTH=1048576

# AI Service (optimized)
AI_TIMEOUT_SECONDS=5
AI_CIRCUIT_FAIL_MAX=3
AI_CIRCUIT_RESET_SECONDS=60
QUIZ_IDEMPOTENCY_TTL_SECONDS=120

# Background Tasks (optimized)
ASYNC_MAX_WORKERS=2

# Query Limits
MAX_QUERY_RESULTS=100
LEADERBOARD_LIMIT=50

# Monitoring (optional)
SENTRY_DSN=

# Server
PORT=5001

